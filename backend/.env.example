# ============================================================
# FraudShield AI — Backend Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file to version control.
# ============================================================

# ---- Application ----
APP_NAME="FraudShield AI"
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173"]

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraudshield_db
# Optional full override:
# DATABASE_URL=postgresql+psycopg://fraudshield:fraudshield@localhost:5432/fraudshield_db

# ---- Redis / Celery ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- ML ----
MODEL_ARTIFACT_DIR=app/ml/artifacts
DEFAULT_FRAUD_THRESHOLD=0.5

# ---- Upload limits ----
MAX_CSV_UPLOAD_SIZE_MB=10
MAX_CSV_UPLOAD_ROWS=50000

# ---- LLM Provider (choose ONE: ollama | groq | openai_compatible) ----
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true
